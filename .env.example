# Copy this file to .env and fill in your own values before running
# `docker compose up -d --build` (or just run ./install.sh, which does this
# for you interactively).

# Host port to expose the dashboard on (the container always listens on
# 3000 internally — this is only the host-side port mapping).
YSB_PORT=3050

# Comma-separated host:port combinations you'll access the dashboard
# through. Homepage's own Host-header check (src/middleware.js) rejects any
# request whose Host header isn't in this list — so include every address
# you'll actually browse to: your LAN IP, a Cloudflare Tunnel hostname,
# localhost for local testing, etc.
# Example: YSB_ALLOWED_HOSTS=192.168.1.50:3050,dashboard.example.com
YSB_ALLOWED_HOSTS=

# Authentication & Security
# Login is ON by default with username "admin" and password "admin".
# IMPORTANT: Change the default credentials at /security before exposing the
# dashboard publicly.

# Set to "false" to disable login entirely (not recommended for public dashboards).
YSB_AUTH_ENABLED=

# External URL of the dashboard (optional for password mode; required for OIDC
# and for Secure cookies over HTTPS).
YSB_EXTERNAL_URL=

# Authentication secret for encrypting sessions and CSRF tokens. Auto-generated
# into config/auth.json on first run. Set this only for multi-replica deployments
# or when config/ is read-only.
YSB_AUTH_SECRET=

# Optional: Pin credentials via environment instead of the stored auth.json file.
# BOTH must be set together, or both are ignored.
YSB_AUTH_USERNAME=
YSB_AUTH_PASSWORD=

# OIDC / SSO Configuration
# All three (ISSUER, CLIENT_ID, CLIENT_SECRET) are required together to enable OIDC.
YSB_OIDC_ISSUER=
YSB_OIDC_CLIENT_ID=
YSB_OIDC_CLIENT_SECRET=

# Optional OIDC display name (shows on login button).
YSB_OIDC_NAME=

# Optional space-separated OIDC scopes (default: openid profile email).
YSB_OIDC_SCOPE=
